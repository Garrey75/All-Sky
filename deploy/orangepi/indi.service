[Unit]
Description=INDI server for All-Sky OrgPi (simulators)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/indiserver -p 7624 indi_simulator_ccd indi_simulator_telescope indi_simulator_focus indi_simulator_wheel
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
